# ---- Required ---------------------------------------------------------
# Absolute path to your media library on this machine (no trailing slash).
# The web UI can only browse and write inside this folder.
MEDIA_DIR=/path/to/your/media

# ---- Network / access --------------------------------------------------
# Listen address. Default 127.0.0.1 = this machine only. Use 0.0.0.0 (or a LAN IP)
# to reach it from other devices - only on a network you trust.
#BIND=127.0.0.1
#PORT=8080
# Optional shared secret. Empty = no login at all. Generate: openssl rand -hex 24
#API_TOKEN=

# ---- File ownership ----------------------------------------------------
# Subtitles are written as this user. Match the owner of your media files
# (run `id -u` and `id -g`).
#PUID=1000
#PGID=1000

# ---- Optional: Jellyfin rescan after jobs ------------------------------
#JELLYFIN_URL=http://jellyfin.local:8096
# API key: Jellyfin dashboard -> API Keys
#JELLYFIN_TOKEN=
# How Jellyfin sees MEDIA_DIR, if it differs (e.g. Jellyfin mounts it at /data)
#JELLYFIN_LIBRARY_PATH=/data

# ---- Optional: storage -------------------------------------------------
# Host paths instead of Docker named volumes (handy for backups / reusing models)
#DATA_DIR=./data
#HF_CACHE=/home/you/.cache/huggingface
# Use a locally built / pinned image instead of the published one
#SUBS_IMAGE=subs-web
